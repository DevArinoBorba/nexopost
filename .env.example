# ============================================
# NexoPost — modelo de configuração
# ============================================
# Copie este arquivo para ".env.local" e preencha os valores.
#   cp .env.example .env.local
#
# NUNCA versione o .env.local (ele contém segredos).
# ============================================

# ---------- Aplicação ----------
# URL pública do app (usada nos redirects OAuth)
APP_URL=http://localhost:3000

# URL pública para servir mídia (exigida pelo Instagram). Ex.: túnel cloudflared
# Em produção, use seu domínio: https://seudominio.com
MEDIA_PUBLIC_URL=

# Pasta de dados (banco SQLite e mídia)
DATA_DIR=./data

# Chave para criptografar os tokens das redes sociais.
# Gere uma nova com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---------- YouTube (Google Cloud) ----------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# ---------- Meta (Facebook + Instagram) ----------
# https://developers.facebook.com/apps
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/facebook/callback
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/oauth/facebook/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
META_GRAPH_VERSION=v25.0

# ---------- TikTok ----------
# https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/oauth/tiktok/callback
